# Copy locally to .env. Never commit the configured file or real credentials.
# Create a dedicated PostgreSQL database/user and replace every placeholder.
DATABASE_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/proposal_workbench?schema=public"
APP_URL="http://127.0.0.1:3020"
SESSION_TTL_HOURS="8"

# Optional for tests only. The database name MUST end with _test.
# Test commands mutate this dedicated disposable database.
# TEST_DATABASE_URL="postgresql://REPLACE_TEST_USER:REPLACE_TEST_PASSWORD@127.0.0.1:5432/proposal_workbench_test?schema=public"
